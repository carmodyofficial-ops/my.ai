<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher foreground: a pair of my.ai-cyan glasses. The raw artwork spans the
     full 108 width (temple tips at x=7 / x=101); adaptive launcher masks only
     guarantee the central ~72x72 safe zone, so the whole group is scaled to 0.72
     about the center (54,54) to keep both temple arms and lens edges inside the
     mask on circular/squircle launchers. Paired with a black background. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:scaleX="0.72"
        android:scaleY="0.72"
        android:pivotX="54"
        android:pivotY="54">

        <!-- left temple arm -->
        <path android:fillColor="#9CDEF2"
            android:pathData="M7,41 L18,46 L18,50 L7,45 Z" />
        <!-- right temple arm -->
        <path android:fillColor="#9CDEF2"
            android:pathData="M101,41 L90,46 L90,50 L101,45 Z" />
        <!-- bridge -->
        <path android:fillColor="#9CDEF2"
            android:pathData="M50,47 h8 v5 h-8 Z" />

        <!-- left lens -->
        <path android:fillColor="#9CDEF2"
            android:pathData="M24,42 h18 a8,8 0 0 1 8,8 v10 a8,8 0 0 1 -8,8 h-18 a8,8 0 0 1 -8,-8 v-10 a8,8 0 0 1 8,-8 Z" />
        <!-- right lens -->
        <path android:fillColor="#9CDEF2"
            android:pathData="M66,42 h18 a8,8 0 0 1 8,8 v10 a8,8 0 0 1 -8,8 h-18 a8,8 0 0 1 -8,-8 v-10 a8,8 0 0 1 8,-8 Z" />
    </group>
</vector>
